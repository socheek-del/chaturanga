{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beanroti-apps",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "app.beanroti.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
