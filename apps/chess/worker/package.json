{
  "name": "@chaturanga/chess-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler d1 migrations apply chess --local && wrangler dev --port 8791",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply chess --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "mkdir -p ../web/dist && vitest run"
  },
  "dependencies": {
    "@chaturanga/protocol": "*",
    "@chaturanga/server-kit": "*",
    "@chaturanga/chess": "*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "wrangler": "^4.131.1"
  }
}
