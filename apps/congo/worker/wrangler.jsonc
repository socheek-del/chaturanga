{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Congo owns its static app, room objects, matchmaker and finished-game database.
  "name": "congo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "congo",
      // Dedicated product database. Melon stages use an isolated local D1 database.
      "database_id": "efebcc8f-ef05-4331-bca2-574b1be05d90",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "RECONNECT_GRACE_MS": "60000" },
  "routes": [{ "pattern": "congo.beanroti.com", "custom_domain": true }],
  "observability": { "enabled": true },
}
