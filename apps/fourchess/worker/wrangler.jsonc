{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fourfold-chess",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "FourChessRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FourChessRoom"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fourchess",
    "database_id": "00000000-0000-4000-8000-000000000024",
    "migrations_dir": "migrations"
  }]
}
