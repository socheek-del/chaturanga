{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Janggi product's own Worker: static assets, /api/*, /ws/*, its Durable Objects and its own D1.
  // It shares no binding, database or domain with any sibling (docs/PLATFORM.md).
  "name": "janggi",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "janggi",
      // Production database, created 2026-11-23 (jg-008). Local dev and tests use a local database.
      "database_id": "9c5a083d-6e82-4577-96bb-f45661865ca9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RECONNECT_GRACE_MS": "60000"
  },
  // The family's subdomain pattern (jg-008). Moving domains: change this and the default in
  // apps/janggi/web/site.config.ts, nothing else.
  "routes": [{ "pattern": "kr-chess.beanroti.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
