{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Shogi product's own Worker: static assets, /api/*, /ws/*, its Durable Objects and its own D1.
  // It shares no binding, database or domain with Makruk or Sittuyin (docs/PLATFORM.md).
  "name": "shogi",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "Matchmaker"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shogi",
      // Production database, created 2026-09-18 (sg-008). Local dev and tests use a local database.
      "database_id": "d94eb466-77e6-4508-98f5-b58062e7a4f6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RECONNECT_GRACE_MS": "60000"
  },
  // The subdomain the owner chose (D8, sg-008). Moving domains: change this and the default in
  // apps/shogi/web/site.config.ts, nothing else.
  "routes": [{ "pattern": "jp-chess.beanroti.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
